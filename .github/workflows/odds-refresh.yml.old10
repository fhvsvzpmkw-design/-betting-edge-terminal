name: Refresh Betting Edge odds

on:
  workflow_dispatch:
  schedule:
    - cron: '45 12,13 * * *'  # 05:45 Vancouver
    - cron: '45 14,15 * * *'  # 07:45 Vancouver
    - cron: '15 16,17 * * *'  # 09:15 Vancouver
    - cron: '55 21,22 * * *'  # 14:55 Vancouver
    - cron: '55 0,1 * * *'    # 17:55 Vancouver

permissions:
  contents: write

jobs:
  refresh:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Pull quota-balanced Bet365 + DraftKings odds
        env:
          ODDS_API_KEY: ${{ secrets.ODDS_API_KEY }}
          EVENT_NAME: ${{ github.event_name }}

        run: |
          node <<'NODE'
          const fs = require('fs');
          const path = require('path');
          const crypto = require('crypto');

          const API_BASE = 'https://api.odds-api.io/v3';
          const API_KEY = process.env.ODDS_API_KEY;
          const BOOKMAKERS = ['Bet365', 'DraftKings'];

          const TARGET_SPORTS = [
            'football',              // soccer
            'american-football',     // NFL / NCAA / CFL
            'basketball',
            'baseball',
            'ice-hockey',
            'tennis',
            'boxing',
            'mma'
          ];

          const TARGET_LOCAL_MINUTES = [
            5 * 60 + 45,
            7 * 60 + 45,
            9 * 60 + 15,
            14 * 60 + 55,
            17 * 60 + 55
          ];

          // Hard run ceiling. This is a maximum, not a spending target.
          const REQUEST_BUDGET = 70;
          const SAFETY_RESERVE = 5;
          const OPTIONAL_STOP_AT = REQUEST_BUDGET - SAFETY_RESERVE;

          // Budget planning. Discovery is dynamic; core and deep stages stop
          // early when the board is smaller than these allowances.
          const CORE_REQUEST_TARGET = 34;
          const DEEP_REQUEST_TARGET = 20;

          const HORIZON_HOURS = 30;
          const PROP_HORIZON_HOURS = 8;
          const EVENTS_PAGE_SIZE = 200;
          const MAX_EVENT_PAGES = 4;
          const MAX_MARKET_AGE_MINUTES = 90;

          // 10 events/request on /odds/multi.
          const MAX_CORE_EVENTS = CORE_REQUEST_TARGET * 10;

          // Deep calls are one event/request.
          const MAX_DEEP_EVENTS = DEEP_REQUEST_TARGET;

          const OUTFILE = path.join('data', 'live-odds.json');
          const TMPFILE = path.join('data', 'live-odds.next.json');

          if (!API_KEY) {
            console.error('Missing GitHub Actions secret ODDS_API_KEY.');
            process.exit(2);
          }

          let requestsUsed = 0;
          const requestLog = [];

          function vancouverClock(date = new Date()) {
            const parts = new Intl.DateTimeFormat('en-CA', {
              timeZone: 'America/Vancouver',
              hour12: false,
              year: 'numeric',
              month: '2-digit',
              day: '2-digit',
              hour: '2-digit',
              minute: '2-digit',
              second: '2-digit'
            }).formatToParts(date);

            const obj = Object.fromEntries(parts.map(p => [p.type, p.value]));
            const hour = Number(obj.hour === '24' ? '0' : obj.hour);

            return {
              date: `${obj.year}-${obj.month}-${obj.day}`,
              hour,
              minute: Number(obj.minute),
              second: Number(obj.second),
              label:
                `${obj.year}-${obj.month}-${obj.day} ` +
                `${String(hour).padStart(2, '0')}:${obj.minute}:${obj.second} ` +
                `America/Vancouver`
            };
          }

          function nearScheduledWindow(clock) {
            if (process.env.EVENT_NAME === 'workflow_dispatch') return true;
            const nowMinutes = clock.hour * 60 + clock.minute;
            return TARGET_LOCAL_MINUTES.some(
              target => Math.abs(nowMinutes - target) <= 20
            );
          }

          function sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
          }

          function remainingBudget() {
            return Math.max(0, REQUEST_BUDGET - requestsUsed);
          }

          async function fetchJson(url, options = {}) {
            const {
              attempts = 2,
              optional = false,
              stage = 'api'
            } = options;

            let lastError;

            for (let attempt = 0; attempt < attempts; attempt++) {
              const ceiling = optional ? OPTIONAL_STOP_AT : REQUEST_BUDGET;

              if (requestsUsed >= ceiling) {
                const error = new Error(
                  `LOCAL_BUDGET_STOP ${stage}: ${requestsUsed}/${REQUEST_BUDGET}`
                );
                error.code = 'LOCAL_BUDGET_STOP';
                throw error;
              }

              requestsUsed++;
              requestLog.push({
                n: requestsUsed,
                stage,
                optional,
                url: url.replace(API_KEY, 'REDACTED')
              });

              try {
                const response = await fetch(url, {
                  headers: {
                    accept: 'application/json',
                    'user-agent': 'betting-edge-terminal/1.4'
                  }
                });

                if (response.ok) return await response.json();

                const body = await response.text();
                const error = new Error(
                  `${response.status} ${response.statusText}: ${body.slice(0, 400)}`
                );

                if (response.status === 429) {
                  error.code = 'RATE_LIMIT';
                  throw error;
                }

                if (response.status < 500) throw error;
                lastError = error;
              } catch (error) {
                if (error?.code === 'RATE_LIMIT') throw error;
                lastError = error;
              }

              if (attempt < attempts - 1) {
                await sleep(800 * (attempt + 1));
              }
            }

            throw lastError;
          }

          function apiUrl(endpoint, params = {}, authenticated = true) {
            const url = new URL(API_BASE + endpoint);

            if (authenticated) {
              url.searchParams.set('apiKey', API_KEY);
            }

            for (const [key, value] of Object.entries(params)) {
              if (value !== undefined && value !== null && value !== '') {
                url.searchParams.set(key, String(value));
              }
            }

            return url.toString();
          }

          function chunks(array, size) {
            const output = [];
            for (let i = 0; i < array.length; i += size) {
              output.push(array.slice(i, i + size));
            }
            return output;
          }

          function normalized(value) {
            return String(value || '')
              .trim()
              .toLowerCase()
              .replace(/\s+/g, ' ');
          }

          function leagueText(event) {
            return normalized([
              event?.league?.name,
              event?.league?.slug,
              event?.tournament?.name,
              event?.sport?.name,
              event?.sport?.slug
            ].filter(Boolean).join(' '));
          }

          function sportSlug(event) {
            return normalized(event?.sport?.slug);
          }

          function eventHoursAway(event, now) {
            const timestamp = Date.parse(event?.date);
            if (!Number.isFinite(timestamp)) return Infinity;
            return (timestamp - now.getTime()) / 3600000;
          }

          function marketAgeMinutes(market, now) {
            const timestamp = Date.parse(market?.updatedAt);
            if (!Number.isFinite(timestamp)) return Infinity;
            return Math.max(0, (now.getTime() - timestamp) / 60000);
          }

          function filterFreshMarketsFromEvent(event, now, diagnostics) {
            if (!event || typeof event !== 'object') return event;

            const copy = {
              ...event,
              bookmakers: {}
            };

            for (const [bookmaker, markets] of Object.entries(event.bookmakers || {})) {
              if (!Array.isArray(markets)) continue;

              const fresh = markets.filter(market => {
                const okay =
                  marketAgeMinutes(market, now) <= MAX_MARKET_AGE_MINUTES;

                if (!okay) diagnostics.staleMarketsRemoved++;
                return okay;
              });

              if (fresh.length) {
                copy.bookmakers[bookmaker] = fresh;
              }
            }

            return copy;
          }

          function marketCount(event) {
            return Object.values(event?.bookmakers || {}).reduce(
              (total, markets) =>
                total + (Array.isArray(markets) ? markets.length : 0),
              0
            );
          }

          function sameEventIdentity(candidate, returned) {
            if (!candidate || !returned) return false;
            if (String(candidate.id) !== String(returned.id)) return false;

            const ch = normalized(candidate.home);
            const ca = normalized(candidate.away);
            const rh = normalized(returned.home);
            const ra = normalized(returned.away);

            if (ch && rh && ch !== rh) return false;
            if (ca && ra && ca !== ra) return false;

            return true;
          }

          function isMajorLeague(event) {
            const text = leagueText(event);
            const sport = sportSlug(event);

            if (sport === 'baseball') {
              return /\bmlb\b|major league baseball/.test(text);
            }

            if (sport === 'ice-hockey') {
              return /\bnhl\b|national hockey league/.test(text);
            }

            if (sport === 'basketball') {
              return /\bnba\b|\bwnba\b|\bncaa\b|college/.test(text);
            }

            if (sport === 'american-football') {
              return /\bnfl\b|\bncaa\b|\bncaaf\b|college|\bcfl\b|canadian football/.test(text);
            }

            if (
              sport === 'boxing' ||
              sport === 'mma' ||
              /boxing|mma|mixed-martial|ufc/.test(sport)
            ) {
              return true;
            }

            return false;
          }

          function eventPriorityScore(event, now) {
            const sport = sportSlug(event);
            const text = leagueText(event);
            const hours = eventHoursAway(event, now);

            let score = 0;

            // Start-time urgency.
            if (hours >= 0 && hours <= 2) score += 100;
            else if (hours <= 4) score += 80;
            else if (hours <= 6) score += 60;
            else if (hours <= 12) score += 40;
            else if (hours <= HORIZON_HOURS) score += 20;

            // Major leagues / high-value sport families.
            if (/\bnfl\b|\bncaaf\b|\bncaa football\b/.test(text)) score += 55;
            if (/\bnhl\b|\bnba\b|\bmlb\b|\bwnba\b/.test(text)) score += 50;
            if (/\bcfl\b|canadian football/.test(text)) score += 40;
            if (sport === 'boxing' || /boxing/.test(sport)) score += 45;
            if (sport === 'mma' || /mma|mixed-martial|ufc/.test(sport)) score += 45;

            // Keep soccer and tennis relevant without letting either dominate.
            if (sport === 'football') score += 20;
            if (sport === 'tennis') score += 18;

            // General basketball/baseball/hockey/football fallback.
            if (sport === 'basketball') score += 15;
            if (sport === 'baseball') score += 15;
            if (sport === 'ice-hockey') score += 15;
            if (sport === 'american-football') score += 15;

            return score;
          }

          function propEligible(event) {
            return isMajorLeague(event);
          }

          function deepPriorityScore(event, now) {
            let score = eventPriorityScore(event, now);
            const hours = eventHoursAway(event, now);

            if (hours >= 0 && hours <= 1.5) score += 70;
            else if (hours <= 3) score += 50;
            else if (hours <= 5) score += 30;

            return score;
          }

          function deepMarkets(event) {
            const output = {};

            for (const [bookmaker, markets] of Object.entries(event?.bookmakers || {})) {
              if (!Array.isArray(markets)) continue;

              const selected = markets.filter(market => {
                const name = normalized(market?.name);
                if (!name) return false;

                return (
                  name.includes('player') ||
                  name.includes('props') ||
                  name.includes('strikeout') ||
                  name.includes('home run') ||
                  name.includes('total bases') ||
                  name.includes('rbi') ||
                  name.includes('shots') ||
                  name.includes('saves') ||
                  name.includes('passing') ||
                  name.includes('receiving') ||
                  name.includes('rushing') ||
                  name.includes('touchdown') ||
                  name.includes('receptions') ||
                  name.includes('points') ||
                  name.includes('rebounds') ||
                  name.includes('assists') ||
                  name.includes('method') ||
                  name.includes('round') ||
                  name.includes('decision') ||
                  name.includes('knockout') ||
                  name.includes('submission')
                );
              });

              if (selected.length) {
                output[bookmaker] = selected;
              }
            }

            return output;
          }

          function fingerprint(markets) {
            const rows = [];

            for (const bookmaker of Object.keys(markets).sort()) {
              for (const market of markets[bookmaker] || []) {
                rows.push({
                  bookmaker,
                  name: String(market?.name || ''),
                  odds: Array.isArray(market?.odds) ? market.odds : []
                });
              }
            }

            if (!rows.length) return null;

            return crypto
              .createHash('sha256')
              .update(JSON.stringify(rows))
              .digest('hex');
          }

          function categoryKey(event) {
            const sport = sportSlug(event);
            const text = leagueText(event);

            if (/\bmlb\b|major league baseball/.test(text)) return 'MLB';
            if (/\bnhl\b|national hockey league/.test(text)) return 'NHL';
            if (/\bnba\b/.test(text)) return 'NBA';
            if (/\bwnba\b/.test(text)) return 'WNBA';
            if (/\bnfl\b/.test(text)) return 'NFL';
            if (/\bncaaf\b|\bncaa football\b|college football/.test(text)) return 'NCAAF';
            if (/\bncaa\b|college basketball/.test(text) && sport === 'basketball') return 'NCAAB';
            if (/\bcfl\b|canadian football/.test(text)) return 'CFL';
            if (sport === 'boxing' || /boxing/.test(sport)) return 'BOXING';
            if (sport === 'mma' || /mma|mixed-martial|ufc/.test(sport)) return 'MMA';
            if (sport === 'football') return 'SOCCER';
            if (sport === 'tennis') return 'TENNIS';
            if (sport === 'baseball') return 'BASEBALL_OTHER';
            if (sport === 'basketball') return 'BASKETBALL_OTHER';
            if (sport === 'ice-hockey') return 'HOCKEY_OTHER';
            if (sport === 'american-football') return 'FOOTBALL_OTHER';
            return sport || 'OTHER';
          }

          // Minimum representation in the priced core board when events exist.
          // The remainder is filled globally by score.
          const CORE_CATEGORY_MINIMUMS = {
            MLB: 20,
            NHL: 20,
            NBA: 20,
            WNBA: 12,
            NFL: 20,
            NCAAF: 30,
            NCAAB: 24,
            CFL: 10,
            BOXING: 12,
            MMA: 16,
            SOCCER: 40,
            TENNIS: 40
          };

          function selectBalancedCore(candidates, now) {
            const byCategory = new Map();

            for (const event of candidates) {
              const key = categoryKey(event);
              if (!byCategory.has(key)) byCategory.set(key, []);
              byCategory.get(key).push({
                event,
                score: eventPriorityScore(event, now)
              });
            }

            for (const items of byCategory.values()) {
              items.sort(
                (a, b) =>
                  b.score - a.score ||
                  String(a.event.date || '').localeCompare(String(b.event.date || ''))
              );
            }

            const selected = [];
            const selectedIds = new Set();

            function take(item) {
              const id = String(item.event.id);
              if (selectedIds.has(id)) return;
              if (selected.length >= MAX_CORE_EVENTS) return;

              selectedIds.add(id);
              selected.push(item.event);
            }

            // Guaranteed representation first.
            for (const [category, minimum] of Object.entries(CORE_CATEGORY_MINIMUMS)) {
              const items = byCategory.get(category) || [];
              for (const item of items.slice(0, minimum)) take(item);
            }

            // Then fill remaining capacity by global relevance.
            const remaining = [];

            for (const items of byCategory.values()) {
              for (const item of items) {
                if (!selectedIds.has(String(item.event.id))) remaining.push(item);
              }
            }

            remaining.sort(
              (a, b) =>
                b.score - a.score ||
                String(a.event.date || '').localeCompare(String(b.event.date || ''))
            );

            for (const item of remaining) {
              if (selected.length >= MAX_CORE_EVENTS) break;
              take(item);
            }

            return selected.sort(
              (a, b) => String(a.date || '').localeCompare(String(b.date || ''))
            );
          }

          async function discoverSport(sport, now, to, diagnostics) {
            const merged = new Map();

            for (let page = 1; page <= MAX_EVENT_PAGES; page++) {
              const rows = await fetchJson(
                apiUrl('/events', {
                  sport,
                  status: 'pending',
                  from: now.toISOString(),
                  to: to.toISOString(),
                  limit: EVENTS_PAGE_SIZE,
                  page
                }),
                {
                  stage: `events:${sport}:p${page}`
                }
              );

              const list = Array.isArray(rows) ? rows : [];
              let added = 0;

              for (const event of list) {
                if (!event?.id) continue;

                if (!merged.has(String(event.id))) {
                  merged.set(String(event.id), event);
                  added++;
                }
              }

              if (list.length < EVENTS_PAGE_SIZE || added === 0) break;
            }

            diagnostics.eventCandidatesBySport[sport] = merged.size;
            return [...merged.values()];
          }

          function readExistingSnapshot() {
            try {
              if (!fs.existsSync(OUTFILE)) return null;

              const parsed = JSON.parse(fs.readFileSync(OUTFILE, 'utf8'));
              return parsed && typeof parsed === 'object' ? parsed : null;
            } catch {
              return null;
            }
          }

          function logErrors(errors) {
            for (const error of errors.slice(0, 30)) {
              console.error(JSON.stringify(error));
            }
          }

          (async () => {
            const clock = vancouverClock();

            if (!nearScheduledWindow(clock)) {
              console.log(`Skipping duplicate DST cron at ${clock.label}.`);
              return;
            }

            const existing = readExistingSnapshot();
            const existingCount = Number(
              existing?.eventCount ||
              existing?.events?.length ||
              0
            );

            const now = new Date();
            const to = new Date(now.getTime() + HORIZON_HOURS * 3600000);

            let sports = [];

            try {
              sports = await fetchJson(
                apiUrl('/sports', {}, false),
                {
                  attempts: 1,
                  stage: 'sports-public'
                }
              );
            } catch {
              sports = await fetchJson(
                apiUrl('/sports', {}, true),
                {
                  attempts: 1,
                  stage: 'sports-auth'
                }
              );
            }

            const availableSlugs = new Set(
              (Array.isArray(sports) ? sports : [])
                .map(sport => String(sport?.slug || ''))
                .filter(Boolean)
            );

            const selectedSports = TARGET_SPORTS.filter(
              sport => availableSlugs.has(sport)
            );

            for (const sport of availableSlugs) {
              if (
                /mma|mixed-martial|ufc|boxing/.test(sport) &&
                !selectedSports.includes(sport)
              ) {
                selectedSports.push(sport);
              }
            }

            const snapshot = {
              schema: 5,
              generatedAt: now.toISOString(),
              generatedAtVancouver: clock.label,
              source: 'Odds-API.io v3',
              bookmakers: BOOKMAKERS,
              horizonHours: HORIZON_HOURS,
              maxMarketAgeMinutes: MAX_MARKET_AGE_MINUTES,

              requestBudget: REQUEST_BUDGET,
              requestsUsed: 0,
              requestsRemaining: REQUEST_BUDGET,

              selectedSports,

              events: [],
              deepMarkets: [],
              baseballProps: [],

              diagnostics: {
                eventCandidatesBySport: {},
                eventCandidatesTotal: 0,

                coreCandidatesSelected: 0,
                coreSelectedByCategory: {},
                coreRequestsUsed: 0,
                mainOddsEvents: 0,
                mainOddsMarkets: 0,
                bet365Events: 0,
                draftKingsEvents: 0,

                deepCandidates: 0,
                deepEventsChecked: 0,
                deepEventsWithMarkets: 0,
                deepMarketsPublished: 0,
                deepEventsSkippedBudget: 0,
                deepEventsSkippedHorizon: 0,

                staleMarketsRemoved: 0,
                identityRejects: 0,
                duplicateDeepRejects: 0,
                previousGoodEventCount: existingCount
              },

              errors: []
            };

            const candidateMap = new Map();

            // PASS 1: broad discovery. Keep the universe broad.
            for (const sport of selectedSports) {
              if (requestsUsed >= OPTIONAL_STOP_AT) break;

              try {
                const rows = await discoverSport(
                  sport,
                  now,
                  to,
                  snapshot.diagnostics
                );

                for (const event of rows) {
                  candidateMap.set(String(event.id), event);
                }
              } catch (error) {
                snapshot.errors.push({
                  stage: 'events',
                  sport,
                  message: String(error?.message || error)
                });

                if (error?.code === 'RATE_LIMIT') break;
              }
            }

            const candidates = [...candidateMap.values()]
              .filter(event => {
                const hours = eventHoursAway(event, now);
                return hours >= -0.25 && hours <= HORIZON_HOURS;
              })
              .sort(
                (a, b) =>
                  String(a.date || '').localeCompare(String(b.date || ''))
              );

            snapshot.diagnostics.eventCandidatesTotal = candidates.length;

            // PASS 2: rank and balance BEFORE spending live-odds requests.
            const coreSelected = selectBalancedCore(candidates, now);

            snapshot.diagnostics.coreCandidatesSelected = coreSelected.length;

            for (const event of coreSelected) {
              const key = categoryKey(event);
              snapshot.diagnostics.coreSelectedByCategory[key] =
                (snapshot.diagnostics.coreSelectedByCategory[key] || 0) + 1;
            }

            const coreRequestStart = requestsUsed;
            let coreBatchesUsed = 0;

            for (const batch of chunks(coreSelected, 10)) {
              if (coreBatchesUsed >= CORE_REQUEST_TARGET) break;

              // Preserve deep-market space rather than consuming the full run
              // ceiling with core pricing.
              const remainingForDeep =
                Math.max(0, DEEP_REQUEST_TARGET - 0);

              if (
                remainingBudget() <=
                Math.min(SAFETY_RESERVE + remainingForDeep, OPTIONAL_STOP_AT)
              ) {
                break;
              }

              const eventIds = batch.map(event => event.id).join(',');
              if (!eventIds) continue;

              try {
                const odds = await fetchJson(
                  apiUrl('/odds/multi', {
                    eventIds,
                    bookmakers: BOOKMAKERS.join(',')
                  }),
                  {
                    stage: 'odds-multi'
                  }
                );

                coreBatchesUsed++;

                if (Array.isArray(odds)) {
                  snapshot.events.push(...odds);
                }
              } catch (error) {
                snapshot.errors.push({
                  stage: 'odds-multi',
                  eventIds,
                  message: String(error?.message || error)
                });

                if (
                  error?.code === 'RATE_LIMIT' ||
                  error?.code === 'LOCAL_BUDGET_STOP'
                ) {
                  break;
                }
              }
            }

            snapshot.diagnostics.coreRequestsUsed =
              requestsUsed - coreRequestStart;

            snapshot.events = [
              ...new Map(
                snapshot.events
                  .filter(event => event?.id)
                  .map(event => [
                    String(event.id),
                    filterFreshMarketsFromEvent(
                      event,
                      now,
                      snapshot.diagnostics
                    )
                  ])
              ).values()
            ]
              .filter(event => marketCount(event) > 0)
              .sort(
                (a, b) =>
                  String(a.date || '').localeCompare(String(b.date || ''))
              );

            snapshot.diagnostics.mainOddsEvents = snapshot.events.length;

            snapshot.diagnostics.mainOddsMarkets =
              snapshot.events.reduce(
                (total, event) => total + marketCount(event),
                0
              );

            snapshot.diagnostics.bet365Events =
              snapshot.events.filter(
                event =>
                  Array.isArray(event?.bookmakers?.Bet365) &&
                  event.bookmakers.Bet365.length
              ).length;

            snapshot.diagnostics.draftKingsEvents =
              snapshot.events.filter(
                event =>
                  Array.isArray(event?.bookmakers?.DraftKings) &&
                  event.bookmakers.DraftKings.length
              ).length;

            // PASS 3: dynamic deep-market queue from the broad discovered board.
            const deepQueue = candidates
              .filter(event => {
                const hours = eventHoursAway(event, now);

                if (hours < 0 || hours > PROP_HORIZON_HOURS) {
                  snapshot.diagnostics.deepEventsSkippedHorizon++;
                  return false;
                }

                return propEligible(event);
              })
              .map(event => ({
                event,
                score: deepPriorityScore(event, now)
              }))
              .sort(
                (a, b) =>
                  b.score - a.score ||
                  String(a.event.date || '').localeCompare(
                    String(b.event.date || '')
                  )
              )
              .slice(0, MAX_DEEP_EVENTS);

            snapshot.diagnostics.deepCandidates = deepQueue.length;

            const deepCandidates = [];
            const deepStart = requestsUsed;

            for (let i = 0; i < deepQueue.length; i++) {
              const { event, score } = deepQueue[i];

              if (
                requestsUsed >= OPTIONAL_STOP_AT ||
                requestsUsed - deepStart >= DEEP_REQUEST_TARGET
              ) {
                snapshot.diagnostics.deepEventsSkippedBudget +=
                  deepQueue.length - i;
                break;
              }

              snapshot.diagnostics.deepEventsChecked++;

              try {
                const raw = await fetchJson(
                  apiUrl('/odds', {
                    eventId: event.id,
                    bookmakers: BOOKMAKERS.join(',')
                  }),
                  {
                    optional: true,
                    attempts: 1,
                    stage: `deep:${sportSlug(event) || 'sport'}`
                  }
                );

                if (!raw || typeof raw !== 'object') continue;

                if (!sameEventIdentity(event, raw)) {
                  snapshot.diagnostics.identityRejects++;

                  snapshot.errors.push({
                    stage: 'deep-identity',
                    requestedEventId: event.id,
                    returnedEventId: raw.id,
                    message:
                      'Rejected deep-market response because event identity did not match.'
                  });

                  continue;
                }

                const fresh = filterFreshMarketsFromEvent(
                  raw,
                  now,
                  snapshot.diagnostics
                );

                const markets = deepMarkets(fresh);

                const count = Object.values(markets).reduce(
                  (total, rows) => total + rows.length,
                  0
                );

                if (!count) continue;

                deepCandidates.push({
                  id: fresh.id,
                  home: fresh.home,
                  away: fresh.away,
                  date: fresh.date,
                  sport: fresh.sport,
                  league: fresh.league,
                  urls: fresh.urls || {},
                  bookmakerIds: fresh.bookmakerIds || {},
                  bookmakers: markets,
                  priorityScore: score,
                  _fingerprint: fingerprint(markets),
                  _marketCount: count
                });
              } catch (error) {
                if (error?.code === 'LOCAL_BUDGET_STOP') {
                  snapshot.diagnostics.deepEventsSkippedBudget +=
                    deepQueue.length - i;
                  break;
                }

                snapshot.errors.push({
                  stage: 'deep-markets',
                  eventId: event.id,
                  message: String(error?.message || error)
                });

                if (error?.code === 'RATE_LIMIT') break;
              }
            }

            const fingerprintMap = new Map();

            for (const item of deepCandidates) {
              if (!item._fingerprint) continue;

              if (!fingerprintMap.has(item._fingerprint)) {
                fingerprintMap.set(item._fingerprint, []);
              }

              fingerprintMap.get(item._fingerprint).push(String(item.id));
            }

            const duplicates = new Set(
              [...fingerprintMap.entries()]
                .filter(([, ids]) => new Set(ids).size > 1)
                .map(([fingerprint]) => fingerprint)
            );

            for (const item of deepCandidates) {
              if (
                item._fingerprint &&
                duplicates.has(item._fingerprint)
              ) {
                snapshot.diagnostics.duplicateDeepRejects++;
                continue;
              }

              const {
                _fingerprint,
                _marketCount,
                ...published
              } = item;

              snapshot.deepMarkets.push(published);
              snapshot.diagnostics.deepEventsWithMarkets++;
              snapshot.diagnostics.deepMarketsPublished += _marketCount;

              if (sportSlug(item) === 'baseball') {
                snapshot.baseballProps.push(published);
              }
            }

            snapshot.eventCount = snapshot.events.length;
            snapshot.deepMarketEventCount = snapshot.deepMarkets.length;
            snapshot.baseballPropEventCount = snapshot.baseballProps.length;

            snapshot.requestsUsed = requestsUsed;
            snapshot.requestsRemaining = remainingBudget();

            snapshot.requestPolicy = {
              hardBudget: REQUEST_BUDGET,
              optionalStopAt: OPTIONAL_STOP_AT,
              safetyReserve: SAFETY_RESERVE,
              coreRequestTarget: CORE_REQUEST_TARGET,
              deepRequestTarget: DEEP_REQUEST_TARGET,
              maxCoreEvents: MAX_CORE_EVENTS,
              maxDeepEvents: MAX_DEEP_EVENTS,
              propHorizonHours: PROP_HORIZON_HOURS,
              strategy:
                'broad discovery; balanced core ranking; deep markets by league/start-time priority'
            };

            snapshot.complete =
              snapshot.eventCount > 0 &&
              !snapshot.errors.some(error =>
                /RATE_LIMIT|429|identity/i.test(
                  String(error.message || '')
                )
              );

            console.log(
              `Requests ${requestsUsed}/${REQUEST_BUDGET}; ` +
              `discovered ${snapshot.diagnostics.eventCandidatesTotal}; ` +
              `core selected ${snapshot.diagnostics.coreCandidatesSelected}; ` +
              `core requests ${snapshot.diagnostics.coreRequestsUsed}; ` +
              `core events ${snapshot.eventCount}; ` +
              `core markets ${snapshot.diagnostics.mainOddsMarkets}; ` +
              `deep candidates ${snapshot.diagnostics.deepCandidates}; ` +
              `deep checked ${snapshot.diagnostics.deepEventsChecked}; ` +
              `deep events ${snapshot.deepMarketEventCount}; ` +
              `deep markets ${snapshot.diagnostics.deepMarketsPublished}; ` +
              `stale removed ${snapshot.diagnostics.staleMarketsRemoved}; ` +
              `errors ${snapshot.errors.length}.`
            );

            if (snapshot.eventCount === 0) {
              logErrors(snapshot.errors);

              console.error(
                `REFRESH REJECTED: 0 usable core events. ` +
                `Published feed unchanged; previous feed had ` +
                `${existingCount} event(s).`
              );

              process.exit(1);
            }

            fs.mkdirSync('data', { recursive: true });

            fs.writeFileSync(
              TMPFILE,
              JSON.stringify(snapshot, null, 2) + '\n',
              'utf8'
            );

            const verify = JSON.parse(
              fs.readFileSync(TMPFILE, 'utf8')
            );

            if (
              !Array.isArray(verify.events) ||
              Number(verify.eventCount) <= 0
            ) {
              throw new Error(
                'Safety validation failed: generated snapshot is not usable.'
              );
            }

            fs.renameSync(TMPFILE, OUTFILE);

            console.log(
              `Published schema 5: ` +
              `${snapshot.eventCount} core events, ` +
              `${snapshot.deepMarketEventCount} deep-market events, ` +
              `${requestsUsed}/${REQUEST_BUDGET} requests used.`
            );

            if (snapshot.errors.length) {
              logErrors(snapshot.errors);
            }
          })().catch(error => {
            try {
              if (fs.existsSync(TMPFILE)) {
                fs.unlinkSync(TMPFILE);
              }
            } catch {}

            console.error(error);
            process.exit(1);
          });

          NODE

      - name: Publish snapshot
        run: |
          git config user.name "betting-edge-bot"
          git config user.email "actions@users.noreply.github.com"

          git add data/live-odds.json

          if git diff --cached --quiet; then
            echo "No validated odds changes to publish."
            exit 0
          fi

          git commit -m "Refresh Betting Edge live odds"
          git push
