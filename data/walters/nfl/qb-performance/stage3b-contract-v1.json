{
  "schemaVersion": "walters-qb-performance-stage3b-contract-v1",
  "module": "WALTERS_QB_PERFORMANCE",
  "stage": 3,
  "substage": "3B",
  "status": "CONTRACT_LOCKED_NON_OPERATIONAL",
  "createdDate": "2026-09-02",
  "operational": false,
  "productionAuthority": false,
  "marketViewed": false,
  "purpose": "Capture and hash-lock the football-performance evidence required by the Stage 3A method, normalize only approved quarterback fields, and reconcile the frozen EA quarterback population to stable nflverse identities before model estimation.",
  "dependsOn": {
    "stage3AContract": "data/walters/nfl/qb-performance/stage3-contract-v1.json",
    "stage2State": "data/walters/nfl/player-values/stage2-current.json",
    "stage2Registry": "data/walters/nfl/player-values/player-values-2026-v1.json",
    "eaNormalizedManifest": "data/walters/nfl/madden27/madden27-current.json"
  },
  "captureWindow": {
    "seasons": [2021, 2022, 2023, 2024, 2025],
    "gameType": "REG",
    "reason": "2021-2024 supplies a four-season history for a chronological 2025 holdout; 2022-2025 supplies the full four-season history available entering 2026.",
    "excludedSeasons": [2020],
    "excludedSeasonReason": "The structurally abnormal 2020 environment is not needed for either the 2025 holdout or the 2026 four-season candidate window."
  },
  "sourceLock": {
    "provider": "nflverse",
    "repository": "nflverse/nflverse-data",
    "playerIdentityReleaseTag": "players",
    "playerIdentityAsset": "players.csv.gz",
    "playerStatsReleaseTag": "stats_player",
    "weeklyAssetPattern": "stats_player_week_{season}.csv.gz",
    "seasonalAssetPattern": "stats_player_reg_{season}.csv.gz",
    "rawPreservationRequired": true,
    "assetMetadataRequired": [
      "releaseId",
      "releaseTag",
      "assetId",
      "assetName",
      "browserDownloadUrl",
      "byteSize",
      "upstreamDigest",
      "computedSha256",
      "assetUpdatedAt",
      "rawPath"
    ],
    "manifest": "data/walters/nfl/qb-performance/source/source-manifest-v1.json",
    "refreshPolicy": "Once the first PASS manifest is committed, ordinary Stage 3B reruns must use the local hash-verified raw assets. Replacing a source asset requires a separately reviewed refresh event."
  },
  "weeklyFieldWhitelist": [
    "player_id",
    "player_display_name",
    "position",
    "recent_team",
    "season",
    "week",
    "season_type",
    "opponent_team",
    "completions",
    "attempts",
    "passing_yards",
    "passing_tds",
    "interceptions",
    "sacks_suffered",
    "sack_yards",
    "sack_fumbles",
    "sack_fumbles_lost",
    "passing_first_downs",
    "passing_epa",
    "carries",
    "rushing_yards",
    "rushing_tds",
    "rushing_fumbles",
    "rushing_fumbles_lost",
    "rushing_first_downs",
    "rushing_epa"
  ],
  "seasonalFieldWhitelist": [
    "player_id",
    "player_display_name",
    "position",
    "recent_team",
    "season",
    "season_type",
    "completions",
    "attempts",
    "passing_yards",
    "passing_tds",
    "interceptions",
    "sacks_suffered",
    "sack_yards",
    "sack_fumbles",
    "sack_fumbles_lost",
    "passing_first_downs",
    "passing_epa",
    "carries",
    "rushing_yards",
    "rushing_tds",
    "rushing_fumbles",
    "rushing_fumbles_lost",
    "rushing_first_downs",
    "rushing_epa"
  ],
  "derivedFields": {
    "dropbacks": "attempts + sacks_suffered",
    "recorded_qb_fumbles": "sack_fumbles + rushing_fumbles",
    "recorded_qb_fumbles_lost": "sack_fumbles_lost + rushing_fumbles_lost",
    "nfl_passer_rating": "Official component formula derived only from completions, attempts, passing_yards, passing_tds and interceptions; null when attempts are zero.",
    "yards_per_attempt": "passing_yards / attempts; null when attempts are zero.",
    "interception_rate": "interceptions / attempts; null when attempts are zero.",
    "sack_rate": "sacks_suffered / dropbacks; null when dropbacks are zero.",
    "fumble_rate": "recorded_qb_fumbles / dropbacks; null when dropbacks are zero. Retained as a Stage 3C candidate definition, not an approved weight.",
    "qb_rushing_yards_per_dropback": "rushing_yards / dropbacks; null when dropbacks are zero. Retained as evidence, not a spread addend."
  },
  "identityPolicy": {
    "identitySource": "nflverse players.csv.gz",
    "eaPopulation": "Every current NFL-team QB in the frozen Stage 2 registry",
    "distributionCohort": "The same top-67 current NFL-team QB cohort used in Stage 2",
    "matchOrder": [
      "explicit reviewed alias keyed by EA player ID",
      "unique normalized full-name plus exact birth date",
      "unique normalized full-name",
      "unique exact birth date plus normalized last name",
      "otherwise BLOCKED_IDENTITY_UNRESOLVED"
    ],
    "nameNormalization": "Unicode fold, lower case, punctuation removal, whitespace collapse and generational-suffix removal.",
    "duplicateGsisAssignmentAllowed": false,
    "noPerformanceHistoryRule": "A resolved player identity with no 2021-2025 regular-season statistical row is allowed as MATCHED_IDENTITY_NO_CAPTURED_STATS; Stage 3C must shrink fully to the EA prior and remain fail-closed for production until its low-sample rule passes.",
    "aliases": "data/walters/nfl/qb-performance/identity-aliases-v1.json",
    "crosswalk": "data/walters/nfl/qb-performance/identity-crosswalk-v1.json"
  },
  "normalization": {
    "weeklyOutput": "data/walters/nfl/qb-performance/normalized/qb-weekly-2021-2025-v1.csv",
    "seasonalOutput": "data/walters/nfl/qb-performance/normalized/qb-seasonal-2021-2025-v1.csv",
    "positiveFieldSelectionOnly": true,
    "marketFieldReadAllowed": false,
    "modelWeightsAllowed": false,
    "candidateQbValuesAllowed": false,
    "grahamFairMutationAllowed": false
  },
  "crosscheck": {
    "method": "Aggregate the normalized weekly regular-season counting fields by player and season and require exact equality to the independently published nflverse regular-season summary asset.",
    "exactCountingFields": [
      "completions",
      "attempts",
      "passing_yards",
      "passing_tds",
      "interceptions",
      "sacks_suffered",
      "sack_yards",
      "sack_fumbles",
      "sack_fumbles_lost",
      "passing_first_downs",
      "carries",
      "rushing_yards",
      "rushing_tds",
      "rushing_fumbles",
      "rushing_fumbles_lost",
      "rushing_first_downs"
    ],
    "mismatchTolerance": 0
  },
  "protectedArtifacts": [
    "data/walters/nfl-power-ratings-ledger.json",
    "data/walters/nfl/personnel-production-current.json",
    "data/walters/nfl/matchup-production-current.json",
    "ACTIVE_GRAHAM_WEEK_NUMBERS",
    "ACTIVE_GRAHAM_PERSONNEL_LEDGER",
    "ACTIVE_GRAHAM_RESEARCH_LEDGER"
  ],
  "writeBoundary": {
    "allowedPrefixes": [
      "data/walters/nfl/qb-performance/",
      "tools/build-walters-qb-performance-stage3b.py",
      "tools/validate-walters-qb-performance-stage3.mjs",
      "tests/walters-qb-performance-stage3.test.mjs",
      ".github/workflows/walters-qb-performance-stage3.yml"
    ],
    "productionArtifactsAllowed": false,
    "weekScopedWritesAllowed": false,
    "uncertaintyOverlayRetirementAllowed": false
  },
  "outputs": {
    "sourceManifest": "data/walters/nfl/qb-performance/source/source-manifest-v1.json",
    "sourceRegistry": "data/walters/nfl/qb-performance/source-registry-v1.json",
    "identityCrosswalk": "data/walters/nfl/qb-performance/identity-crosswalk-v1.json",
    "weeklyNormalized": "data/walters/nfl/qb-performance/normalized/qb-weekly-2021-2025-v1.csv",
    "seasonalNormalized": "data/walters/nfl/qb-performance/normalized/qb-seasonal-2021-2025-v1.csv",
    "audit": "data/walters/nfl/qb-performance/stage3b-audit-v1.json",
    "current": "data/walters/nfl/qb-performance/stage3-current.json"
  },
  "acceptance": {
    "requiredSourceAssets": 11,
    "requiredSeasons": [2021, 2022, 2023, 2024, 2025],
    "requireAllAssetHashes": true,
    "requireRawAssetsPresent": true,
    "requireZeroCurrentEaQbIdentityBlocks": true,
    "requireTop67Count": 67,
    "requireZeroDuplicateGsisAssignments": true,
    "requireZeroSeasonalCrosscheckMismatches": true,
    "requireZeroForbiddenOutputFields": true,
    "requireMarketViewedFalse": true,
    "requireProductionAuthorityFalse": true,
    "passState": "STAGE3B_CAPTURED_IDENTITY_AUDITED_NON_OPERATIONAL",
    "failState": "STAGE3B_FAIL_CLOSED_REVIEW_REQUIRED",
    "nextSubstageOnPass": "STAGE3C_MODEL_ESTIMATION_AND_HOLDOUT_VALIDATION"
  }
}
